local deftest = require("deftest.deftest")

--- Every suite in the project, listed explicitly. Order is part of the contract and lives here.
-- The requires are literal on purpose: bob finds Lua dependencies by reading `require` string
-- literals, so a module required through a variable never reaches the build.
local SUITES = {
	require("config.tests.config_test"),
	require("features.board.tests.rng_test"),
	require("features.board.tests.outcome_test"),
	require("features.board.tests.geometry_test"),
	require("features.board.tests.route_test"),
	require("features.board.tests.payout_test"),
	require("features.board.tests.stats_test"),
	require("features.board.tests.pool_test"),
	require("features.board.tests.fall_test"),
	require("features.board.tests.drop_queue_test"),
	require("features.currency.tests.wallet_test"),
	require("features.currency.tests.regeneration_test"),
}

function init(self)
	for _, suite in ipairs(SUITES) do
		deftest.add(suite)
	end
	deftest.run()
end
