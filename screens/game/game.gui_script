local ball_view = require("features.board.view.ball_view")
local board = require("features.board.logic.board")
local board_view = require("features.board.view.board_view")
local config = require("config.init")
local currency = require("features.currency.currency")
local debug_overlay = require("features.debug.debug_overlay")
local drop_queue = require("features.board.logic.drop_queue")
local druid = require("druid.druid")
local falling = require("features.board.view.falling")
local report = require("features.debug.logic.report")
local monarch = require("monarch.monarch")
local payout = require("features.board.logic.payout")
local rng = require("features.board.logic.rng")
local stats = require("features.board.logic.stats")

local DEBUG = hash("debug")

local BALLS = "balls"
local SCORE = "score"

local GLOW_PULSE_TIME = 0.12

local function show_balls(self, balance)
	gui.set_text(self.balls_label, "BALLS " .. balance)
	self.drop_one:set_enabled(balance >= 1)
	self.drop_many:set_enabled(balance >= self.drop_config.multi_count)
end

local function show_score(self, balance)
	gui.set_text(self.score_label, "SCORE " .. balance)
end

--- Pays a win and counts it. Called on landing, and for every ball still falling when the
--- screen closes.
local function settle(self, ball)
	local drop = payout.release(self.payout, ball.payout_id)
	if not drop then
		return
	end
	currency.add(SCORE, drop.score)
	stats.record(self.stats, drop.basket, drop.score)
end

local function pulse_pin(self, index)
	local glow = self.nodes.glows[index]
	if not glow then
		return
	end

	local base = self.glow_scale
	gui.set_scale(glow, base * 1.35)
	gui.animate(glow, gui.PROP_SCALE, base, gui.EASING_OUTQUAD, GLOW_PULSE_TIME)
end

--- Spends the balls, draws every outcome and holds every win up front, then queues them.
-- Charging per launch instead would let the balance be spent elsewhere mid-queue, leaving the
-- press half done.
local function request_drops(self, count)
	if not currency.spend(BALLS, count) then
		return
	end

	local entries = {}
	for index = 1, count do
		local drop = board.drop(self.board, self.outcome_rng, self.route_rng)
		entries[index] = { drop = drop, payout_id = payout.hold(self.payout, drop) }
	end
	drop_queue.push(self.queue, entries)
end

local function launch(self, entry)
	local x, y = board.ball_position(self.board, entry.drop.positions, 0)
	local node = ball_view.take(self.balls_pool, x, y)
	falling.launch(self.falling, node, entry.drop, entry.payout_id)
end

function init(self)
	msg.post(".", "acquire_input_focus")

	-- The menu says which board to build; opening the screen directly falls back to the default.
	local chosen = monarch.data(hash("game"))
	local settings = config.get(chosen and chosen.preset)
	local view = settings.board.view
	self.drop_config = settings.drop
	self.board = board.new(settings.board, view.width, view.height)
	self.glow_scale = vmath.vector3(view.pin_scale * view.pin_glow_scale)

	self.nodes = board_view.build(self.board, view)
	self.balls_pool = ball_view.new(view)
	self.payout = payout.new()
	self.queue = drop_queue.new(settings.drop.queue_interval)
	self.overlay = debug_overlay.new({ x = 20, y = 1240 })
	self.stats = stats.new(self.board.config.baskets)

	-- Two streams: visual tuning must not move the odds.
	local seed = math.floor(socket.gettime() * 1000)
	self.outcome_rng = rng.new(seed)
	self.route_rng = rng.new(seed + 7919)

	self.falling = falling.new(self.board.geometry, settings.board.fall, {
		on_land = function(ball)
			settle(self, ball)
			ball_view.give(self.balls_pool, ball.node)
		end,
		on_strike = function(index)
			pulse_pin(self, index)
		end,
	})

	self.druid = druid.new(self)
	self.score_label = gui.get_node("score")
	self.balls_label = gui.get_node("balls_label")
	self.timer_label = gui.get_node("timer_label")

	self.drop_one = self.druid:new_button("drop_one", function()
		request_drops(self, 1)
	end)
	self.drop_many = self.druid:new_button("drop_many", function()
		request_drops(self, self.drop_config.multi_count)
	end)
	self.druid:new_button("grant", function()
		currency.add(BALLS, self.drop_config.multi_count)
	end)
	self.druid:new_button("back", function()
		monarch.back()
	end)

	self.on_balls = function(balance)
		show_balls(self, balance)
	end
	self.on_score = function(balance)
		show_score(self, balance)
	end
	currency.on_change(BALLS, self.on_balls)
	currency.on_change(SCORE, self.on_score)

	show_balls(self, currency.balance(BALLS))
	show_score(self, currency.balance(SCORE))
end

function final(self)
	-- Falls are disposable, wins are not: drop the animations and the queue, pay everything held.
	for _, ball in ipairs(falling.cancel_all(self.falling)) do
		settle(self, ball)
	end
	for _, entry in ipairs(drop_queue.take_all(self.queue)) do
		settle(self, entry)
	end
	ball_view.give_all(self.balls_pool)

	currency.off_change(BALLS, self.on_balls)
	currency.off_change(SCORE, self.on_score)
	self.druid:final()
end

function update(self, dt)
	self.druid:update(dt)

	local ready = drop_queue.update(self.queue, dt)
	if ready then
		for _, entry in ipairs(ready) do
			launch(self, entry)
		end
	end

	falling.update(self.falling, dt)

	local seconds = currency.time_to_next(BALLS)
	gui.set_text(self.timer_label, seconds and ("NEXT %.0f"):format(seconds) or "NEXT --")

	if debug_overlay.is_visible(self.overlay) then
		debug_overlay.draw(self.overlay, self.stats, stats.report(self.stats, board.chances(self.board)), {
			balls = currency.balance(BALLS),
			in_flight = falling.count(self.falling),
			queued = drop_queue.count(self.queue),
		})
	end
end

function on_message(self, message_id, message, sender)
	self.druid:on_message(message_id, message, sender)
end

function on_input(self, action_id, action)
	if action_id == DEBUG and action.pressed then
		if debug_overlay.toggle(self.overlay) then
			-- Printed on open so the numbers are in the log too, where they can be copied.
			print("DEBUG: " .. report.weights_line(board.natural_weights(self.board)))
		end
		return true
	end

	return self.druid:on_input(action_id, action)
end
