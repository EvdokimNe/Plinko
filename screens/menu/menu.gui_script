local currency = require("features.currency.currency")
local druid = require("druid.druid")
local monarch = require("monarch.monarch")

local function show_balls(self, balance)
	gui.set_text(self.balls, "Balls: " .. balance)
end

function init(self)
	msg.post(".", "acquire_input_focus")
	self.druid = druid.new(self)
	self.druid:new_button("play", function()
		monarch.show(hash("game"))
	end)

	self.balls = gui.get_node("balls")

	-- On self so `final` can unsubscribe exactly this one. See PITFALLS.md.
	self.on_balls = function(balance)
		show_balls(self, balance)
	end
	currency.on_change("balls", self.on_balls)
	show_balls(self, currency.balance("balls"))
end

function final(self)
	currency.off_change("balls", self.on_balls)
	self.druid:final()
end

function update(self, dt)
	self.druid:update(dt)
end

function on_message(self, message_id, message, sender)
	self.druid:on_message(message_id, message, sender)
end

function on_input(self, action_id, action)
	return self.druid:on_input(action_id, action)
end
