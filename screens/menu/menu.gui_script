local config = require("config.init")
local currency = require("features.currency.currency")
local druid = require("druid.druid")
local monarch = require("monarch.monarch")

local BALLS = "balls"

local FIRST_BUTTON_Y = 680
local BUTTON_SPACING = 190

local function show_balls(self, balance)
	gui.set_text(self.balls, "Balls: " .. balance)
end

--- One button per preset, cloned from a hidden template. Adding a board is a config entry.
local function build_buttons(self)
	local template = gui.get_node("preset_template")
	local parent = gui.get_node("presets")
	local label_id = gui.get_id(gui.get_node("preset_label"))

	for index, preset in ipairs(config.presets()) do
		local cloned = gui.clone_tree(template)
		local button = cloned[gui.get_id(template)]

		gui.set_parent(button, parent)
		gui.set_enabled(button, true)
		gui.set_position(button, vmath.vector3(360, FIRST_BUTTON_Y - (index - 1) * BUTTON_SPACING, 0))
		gui.set_text(cloned[label_id], preset.label)

		self.druid:new_button(button, function()
			monarch.show(hash("game"), nil, { preset = preset.id })
		end)
	end
end

function init(self)
	msg.post(".", "acquire_input_focus")
	self.druid = druid.new(self)
	self.balls = gui.get_node("balls")

	build_buttons(self)

	self.on_balls = function(balance)
		show_balls(self, balance)
	end
	currency.on_change(BALLS, self.on_balls)
	show_balls(self, currency.balance(BALLS))
end

function final(self)
	currency.off_change(BALLS, self.on_balls)
	self.druid:final()
end

function update(self, dt)
	self.druid:update(dt)
end

function on_message(self, message_id, message, sender)
	self.druid:on_message(message_id, message, sender)
end

function on_input(self, action_id, action)
	return self.druid:on_input(action_id, action)
end
