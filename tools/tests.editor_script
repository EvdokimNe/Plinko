--- Adds "Run Tests" to the editor's Project menu, so tests run the way they do in an IDE:
--- one click, results in the console.
-- The work itself lives in tools/test.ps1 — the same script the terminal and CI use, so there is
-- one way to run tests rather than three that drift apart.
local M = {}

local function run_tests()
	-- Unsaved edits would be invisible to bob, which builds from disk.
	editor.save()

	local output = editor.execute("powershell", "-NoProfile", "-ExecutionPolicy", "Bypass",
		"-File", "tools/test.ps1", {
			out = "capture",
			reload_resources = false,
		})

	print(output)
end

function M.get_commands()
	return {
		{
			label = "Run Tests",
			locations = { "Project" },
			run = function()
				run_tests()
			end,
		},
	}
end

return M
