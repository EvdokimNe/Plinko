--- Adds "Set Binomial Weights" to the Assets context menu of a board preset. It rewrites the
--- preset's `weights` with the pyramid's own distribution — the number of paths that reach each
--- basket — so the configured odds match what the geometry would produce on its own.
-- The maths is not repeated here: it is the same `route` module the game draws with, so the
-- editor command and the game can never disagree about the numbers.
local route = require("features.board.logic.route")

local M = {}

local PRESETS = "/config/presets/"

local function is_preset(path)
	return path
		and path:sub(1, #PRESETS) == PRESETS
		and path:sub(-4) == ".lua"
end

--- Evaluates the preset as the editor currently holds it, unsaved edits included. `require`
--- would hand back whatever was cached when the editor started, which is stale the moment the
--- file is touched.
local function evaluate(text, path)
	local chunk, message = load(text, path)
	assert(chunk, message)
	return chunk()
end

local function weights_line(weights)
	local parts = {}
	for index, weight in ipairs(weights) do
		-- The counts are built by repeated multiplication and divide exactly, but they arrive as
		-- floats; the file should carry plain integers.
		parts[index] = string.format("%d", math.floor(weight + 0.5))
	end
	return "weights = { " .. table.concat(parts, ", ") .. " }"
end

local function set_weights(selection, path)
	local text = editor.get(selection, "text")
	local preset = evaluate(text, path)

	assert(type(preset) == "table", path .. " did not return a table")
	assert(preset.rows and preset.basket_of_slot, path .. " has no rows or basket_of_slot")

	local weights = route.natural_weights(route.new(preset.rows, preset.basket_of_slot))

	-- %b{} spans the braces of the current list however it is wrapped, so a reformatted preset
	-- is still matched.
	local updated, replaced = text:gsub("weights%s*=%s*%b{}", weights_line(weights), 1)
	assert(replaced == 1, path .. " has no weights list to replace")

	editor.transact({ editor.tx.set(selection, "text", updated) })
	print("Binomial weights written to " .. path .. ": " .. weights_line(weights))
end

function M.get_commands()
	return {
		{
			label = "Set Binomial Weights",
			locations = { "Assets" },
			query = {
				selection = { type = "resource", cardinality = "one" },
			},
			active = function(opts)
				return is_preset(editor.get(opts.selection, "path"))
			end,
			run = function(opts)
				set_weights(opts.selection, editor.get(opts.selection, "path"))
			end,
		},
	}
end

return M
